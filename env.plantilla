# --- Google (Ads, GA4 y Search Console) ---
# Desde el 9-sep-2026 el acceso a la API de Google Ads lo da el proyecto de Google Cloud:
# una cuenta de servicio de solo lectura alcanza para las tres fuentes.
# La clave JSON va fuera del repo (chmod 600). Verificar: venv/bin/python3 scripts/verificar_google.py
GOOGLE_SA_KEY_FILE=
# Cuentas de Google Ads por marca, sin guiones: 1234567890:Renault,0987654321:Jetour
GOOGLE_ADS_CUSTOMER_IDS=
# Legado (antes del 9-sep-2026). El token de desarrollador ya no se usa; Google lo ignora.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# Datacar (catálogo público 0km PY; clave pública embebida en el sitio)
DATACAR_API_KEY=
