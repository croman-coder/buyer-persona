# ===========================================================================
# Variables de entorno para el Generador de Buyer Persona
# Copia este archivo a ".env" y completa con tus credenciales reales.
# ===========================================================================

# --- Google Ads ---
# https://developers.google.com/google-ads/api/docs/oauth/overview
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# --- Meta Ads (Facebook / Instagram) ---
# https://developers.facebook.com/tools/explorer/
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=act_
# Portfolio multi-cuenta (opcional, tiene prioridad sobre AD_ACCOUNT_ID):
#   Una sola cuenta: act_1234567890
#   Varias cuentas:  act_111:Marca1,act_222:Marca2,act_333:Marca3
META_ADS_AD_ACCOUNT_IDS=
META_ADS_APP_ID=
META_ADS_APP_SECRET=

# --- OpenAI (opcional, para enriquecimiento con IA) ---
OPENAI_API_KEY=

# ===========================================================================
# Notificaciones (opcional — para alertas automáticas del cron)
# Dejar vacío lo que no uses. El pipeline avisa SOLO si algo falla.
# ===========================================================================

# --- Telegram (recomendado) ---
# 1. Hablar con @BotFather → /newbot → copiar el token
# 2. Hablar con @userinfobot → copiar tu chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Webhook (Slack, Discord, etc.) ---
# Slack:    https://hooks.slack.com/services/...
# Discord:  https://discord.com/api/webhooks/...
WEBHOOK_URL=

# --- Email (requiere mailutils/postfix instalado) ---
# sudo apt install mailutils
ALERT_EMAIL=